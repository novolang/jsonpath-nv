// jperror.nv — the one fault type, and where in the query it is.
//
// Every fault is a fault in the query.  RFC 9535 section 2.1 has a
// query checked before it runs, and sections 2.3.5.2.2 and 2.4 make
// every disagreement during a run answer false or an empty nodelist:
// a string compared with a number is false, `match()` with a pattern
// that is not I-Regexp is false, and a selector that names nothing
// selects nothing.  So `jpquery.parse` answers a `Result` and
// `jpeval.select` does not.
//
// A fault's range is a byte range into the query text.

// What was wrong with the query.
//
// ```novo
// use jperror
//
// fn main() [io]
//     println(jperror.kind_name(JpNotSingular))
// ```
pub enum JpFaultKind
    // The query did not begin with `$`, or a filter's query did not
    // begin with `@` or `$`.
    JpNoRoot
    // A segment that is neither `.name`, `.*`, `..` nor `[...]`, or a
    // selector that is none of the five.
    JpBadSelector
    // A member name that is neither a valid shorthand nor a string
    // literal: a shorthand starting with a digit, or a string holding
    // a control character.
    JpBadName
    // An array index, or a slice's part, outside the range RFC 9535
    // section 2.1 allows, -(2^53 - 1) to 2^53 - 1, or written with a
    // leading zero or as `-0`.
    JpBadIndex
    // A filter expression that does not parse: a dangling `&&`, an
    // unclosed parenthesis, a literal standing alone, a comparison of
    // two comparisons.
    JpBadFilter
    // A function name that is not one of the five RFC 9535 defines.
    JpUnknownFunction
    // A function called with the wrong number of arguments.
    JpWrongArity
    // An argument, or a function's result, of a type its position does
    // not take: section 2.4.3's well-typedness rules.  `length(@.*)`
    // passes a nodelist where a value belongs, and `match()` compared
    // with `==` is a logical result where a value belongs.
    JpWrongArgumentType
    // A query that is not singular where only a singular one may
    // stand: a comparison's operand, or the query `parse_singular`
    // reads.  A query that is not singular passed where a value is
    // declared is `JpWrongArgumentType`.
    JpNotSingular
    // Characters after the end of a complete query.
    JpTrailingInput
    // The query ended inside a construct.
    JpUnexpectedEnd
    // A `\` escape in a string literal that RFC 9535 section 2.3.1.1
    // does not define, or a `\u` escape that names a lone surrogate.
    JpBadEscape
    // A pattern that is not I-Regexp (RFC 9485).  Answered by
    // `jpregex.compile`; `match()` and `search()` answer false for such
    // a pattern, as RFC 9535 section 2.4.6 says.
    JpBadRegex
    // A `\p{...}` or `\P{...}` in a pattern compiled without the
    // general-category lookup that resolves it.
    JpNoCategoryLookup

// A fault: what, and where in the query.
//
// ```novo
// use jperror
//
// fn main() [io]
//     let f = jperror.fault(JpBadIndex, 7, 12)
//     println("${f.at}")
// ```
pub struct JpFault
    kind: JpFaultKind
    // The byte offset in the query where the fault begins.
    at: Int
    // One past the last byte of the construct at fault.
    to: Int

// The standard `Error` implementation, so a fault is reported by
// anything that reports errors.
impl Error for JpFault
    // The message `jperror.message` writes.
    fn message(self) -> Str
        message(self)

// A fault from its parts.
//
// ```novo
// use jperror
//
// fn main() [io]
//     println(jperror.kind_name(jperror.fault(JpNoRoot, 0, 1).kind))
// ```
pub fn fault(kind: JpFaultKind, at: Int, to: Int) -> JpFault []
    JpFault { kind: kind, at: at, to: to }

// The kind's name: lower case with hyphens, such as `not-singular`.
//
// The names do not change between releases, so a program may quote
// them.
//
// ```novo
// use jperror
//
// fn main() [io]
//     println(jperror.kind_name(JpWrongArity))
// ```
pub fn kind_name(kind: JpFaultKind) -> Str []
    match kind
        JpNoRoot            => "no-root"
        JpBadSelector       => "bad-selector"
        JpBadName           => "bad-name"
        JpBadIndex          => "bad-index"
        JpBadFilter         => "bad-filter"
        JpUnknownFunction   => "unknown-function"
        JpWrongArity        => "wrong-arity"
        JpWrongArgumentType => "wrong-argument-type"
        JpNotSingular       => "not-singular"
        JpTrailingInput     => "trailing-input"
        JpUnexpectedEnd     => "unexpected-end"
        JpBadEscape         => "bad-escape"
        JpBadRegex          => "bad-regex"
        JpNoCategoryLookup  => "no-category-lookup"

// One line about the fault: its kind's name and its byte range in the
// query.
//
// The query is not quoted, because a fault does not hold it.  A caller
// that wants to underline the characters has the text and the range.
//
// ```novo
// use jperror
//
// fn main() [io]
//     println(jperror.message(jperror.fault(JpUnknownFunction, 3, 9)))
// ```
pub fn message(f: JpFault) -> Str []
    "${kind_name(f.kind)} at bytes ${f.at} to ${f.to} of the query"
