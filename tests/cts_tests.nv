@test
fn test_cts_013() [io]
    test.case("functions, search, result cannot be compared")
    test.assert(refused("\$[?search(@.a, 'a.*')==true]"))
    test.case("functions, search, too few params")
    test.assert(refused("\$[?search(@.a)]"))
    test.case("functions, search, too many params")
    test.assert(refused("\$[?search(@.a,@.b,@.c)]"))
    test.case("functions, search, arg is a function expression")
    test.assert(selects("\$.values[?search(@, value(\$..['regex']))]",
        "{\"regex\":\"b.?b\",\"values\":[\"abc\",\"bcd\",\"bab\",\"bba\",\"bbab\",\"b\",true,[],{}]}",
        ["[\"bab\",\"bba\",\"bbab\"]"],
        ["\$['values'][2]\n\$['values'][3]\n\$['values'][4]"]))
    test.case("functions, search, dot in character class")
    test.assert(selects("\$[?search(@, 'a[.b]c')]",
        "[\"x abc y\",\"x a.c y\",\"x axc y\"]",
        ["[\"x abc y\",\"x a.c y\"]"],
        ["\$[0]\n\$[1]"]))
    test.case("functions, search, escaped dot")
    test.assert(selects("\$[?search(@, 'a\\\\.c')]",
        "[\"x abc y\",\"x a.c y\",\"x axc y\"]",
        ["[\"x a.c y\"]"],
        ["\$[1]"]))
    test.case("functions, search, escaped backslash before dot")
    test.assert(selects("\$[?search(@, 'a\\\\\\\\.c')]",
        "[\"x abc y\",\"x a.c y\",\"x axc y\",\"x a\\\\ c y\"]",
        ["[\"x a\\\\ c y\"]"],
        ["\$[3]"]))
    test.case("functions, search, escaped left square bracket")
    test.assert(selects("\$[?search(@, 'a\\\\[.c')]",
        "[\"x abc y\",\"x a.c y\",\"x a[ c y\"]",
        ["[\"x a[ c y\"]"],
        ["\$[2]"]))
    test.case("functions, search, escaped right square bracket")
    test.assert(selects("\$[?search(@, 'a[\\\\].]c')]",
        "[\"x abc y\",\"x a.c y\",\"x a c y\",\"x a]c y\"]",
        ["[\"x a.c y\",\"x a]c y\"]"],
        ["\$[1]\n\$[3]"]))
    test.case("functions, value, single-value nodelist")
    test.assert(selects("\$[?value(@.*)==4]",
        "[[4],{\"foo\":4},[5],{\"foo\":5},4]",
        ["[[4],{\"foo\":4}]"],
        ["\$[0]\n\$[1]"]))
    test.case("functions, value, multi-value nodelist")
    test.assert(selects("\$[?value(@.*)==4]", "[[4,4],{\"foo\":4,\"bar\":4}]", ["[]"], [""]))
    test.case("functions, value, too few params")
    test.assert(refused("\$[?value()==4]"))
    test.case("functions, value, too many params")
    test.assert(refused("\$[?value(@.a,@.b)==4]"))
    test.case("functions, value, result must be compared")
    test.assert(refused("\$[?value(@.a)]"))
    test.case("whitespace, filter, space between question mark and expression")
    test.assert(selects("\$[? @.a]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, newline between question mark and expression")
    test.assert(selects("\$[?\n@.a]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, tab between question mark and expression")
    test.assert(selects("\$[?\t@.a]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, return between question mark and expression")
    test.assert(selects("\$[?\r@.a]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, space between question mark and parenthesized expression")
    test.assert(selects("\$[? (@.a)]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, newline between question mark and parenthesized expression")
    test.assert(selects("\$[?\n(@.a)]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, tab between question mark and parenthesized expression")
    test.assert(selects("\$[?\t(@.a)]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, return between question mark and parenthesized expression")
    test.assert(selects("\$[?\r(@.a)]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, space between parenthesized expression and bracket")
    test.assert(selects("\$[?(@.a) ]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, newline between parenthesized expression and bracket")
    test.assert(selects("\$[?(@.a)\n]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, tab between parenthesized expression and bracket")
    test.assert(selects("\$[?(@.a)\t]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, return between parenthesized expression and bracket")
    test.assert(selects("\$[?(@.a)\r]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, space between bracket and question mark")
    test.assert(selects("\$[ ?@.a]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, newline between bracket and question mark")
    test.assert(selects("\$[\n?@.a]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, tab between bracket and question mark")
    test.assert(selects("\$[\t?@.a]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, filter, return between bracket and question mark")
    test.assert(selects("\$[\r?@.a]",
        "[{\"a\":\"b\",\"d\":\"e\"},{\"b\":\"c\",\"d\":\"f\"}]",
        ["[{\"a\":\"b\",\"d\":\"e\"}]"],
        ["\$[0]"]))
    test.case("whitespace, functions, space between function name and parenthesis")
    test.assert(refused("\$[?count (@.*)==1]"))
    test.case("whitespace, functions, newline between function name and parenthesis")
    test.assert(refused("\$[?count\n(@.*)==1]"))
    test.case("whitespace, functions, tab between function name and parenthesis")
    test.assert(refused("\$[?count\t(@.*)==1]"))
    test.case("whitespace, functions, return between function name and parenthesis")
    test.assert(refused("\$[?count\r(@.*)==1]"))
    test.case("whitespace, functions, space between parenthesis and arg")
    test.assert(selects("\$[?count( @.*)==1]",
        "[{\"a\":1},{\"b\":2},{\"a\":2,\"b\":1}]",
        ["[{\"a\":1},{\"b\":2}]"],
        ["\$[0]\n\$[1]"]))
    test.case("whitespace, functions, newline between parenthesis and arg")
    test.assert(selects("\$[?count(\n@.*)==1]",
        "[{\"a\":1},{\"b\":2},{\"a\":2,\"b\":1}]",
        ["[{\"a\":1},{\"b\":2}]"],
        ["\$[0]\n\$[1]"]))
    test.case("whitespace, functions, tab between parenthesis and arg")
    test.assert(selects("\$[?count(\t@.*)==1]",
        "[{\"a\":1},{\"b\":2},{\"a\":2,\"b\":1}]",
        ["[{\"a\":1},{\"b\":2}]"],
        ["\$[0]\n\$[1]"]))
    test.case("whitespace, functions, return between parenthesis and arg")
    test.assert(selects("\$[?count(\r@.*)==1]",
        "[{\"a\":1},{\"b\":2},{\"a\":2,\"b\":1}]",
        ["[{\"a\":1},{\"b\":2}]"],
        ["\$[0]\n\$[1]"]))
    test.case("whitespace, functions, space between arg and comma")
    test.assert(selects("\$[?search(@ ,'[a-z]+')]", "[\"foo\",\"123\"]", ["[\"foo\"]"], ["\$[0]"]))
    test.case("whitespace, functions, newline between arg and comma")
    test.assert(selects("\$[?search(@\n,'[a-z]+')]", "[\"foo\",\"123\"]", ["[\"foo\"]"], ["\$[0]"]))

@test
fn test_cts_014() [io]
    test.case("whitespace, functions, tab between arg and comma")
    test.assert(selects("\$[?search(@\t,'[a-z]+')]", "[\"foo\",\"123\"]", ["[\"foo\"]"], ["\$[0]"]))
    test.case("whitespace, functions, return between arg and comma")
    test.assert(selects("\$[?search(@\r,'[a-z]+')]", "[\"foo\",\"123\"]", ["[\"foo\"]"], ["\$[0]"]))
    test.case("whitespace, functions, space between comma and arg")
    test.assert(selects("\$[?search(@, '[a-z]+')]", "[\"foo\",\"123\"]", ["[\"foo\"]"], ["\$[0]"]))
    test.case("whitespace, functions, newline between comma and arg")
    test.assert(selects("\$[?search(@,\n'[a-z]+')]", "[\"foo\",\"123\"]", ["[\"foo\"]"], ["\$[0]"]))
    test.case("whitespace, functions, tab between comma and arg")
    test.assert(selects("\$[?search(@,\t'[a-z]+')]", "[\"foo\",\"123\"]", ["[\"foo\"]"], ["\$[0]"]))
    test.case("whitespace, functions, return between comma and arg")
    test.assert(selects("\$[?search(@,\r'[a-z]+')]", "[\"foo\",\"123\"]", ["[\"foo\"]"], ["\$[0]"]))
    test.case("whitespace, functions, space between arg and parenthesis")
    test.assert(selects("\$[?count(@.* )==1]",
        "[{\"a\":1},{\"b\":2},{\"a\":2,\"b\":1}]",
        ["[{\"a\":1},{\"b\":2}]"],
        ["\$[0]\n\$[1]"]))
    test.case("whitespace, functions, newline between arg and parenthesis")
    test.assert(selects("\$[?count(@.*\n)==1]",
        "[{\"a\":1},{\"b\":2},{\"a\":2,\"b\":1}]",
        ["[{\"a\":1},{\"b\":2}]"],
        ["\$[0]\n\$[1]"]))
    test.case("whitespace, functions, tab between arg and parenthesis")
    test.assert(selects("\$[?count(@.*\t)==1]",
        "[{\"a\":1},{\"b\":2},{\"a\":2,\"b\":1}]",
        ["[{\"a\":1},{\"b\":2}]"],
        ["\$[0]\n\$[1]"]))
    test.case("whitespace, functions, return between arg and parenthesis")
    test.assert(selects("\$[?count(@.*\r)==1]",
        "[{\"a\":1},{\"b\":2},{\"a\":2,\"b\":1}]",
        ["[{\"a\":1},{\"b\":2}]"],
        ["\$[0]\n\$[1]"]))
    test.case("whitespace, functions, spaces in a relative singular selector")
    test.assert(selects("\$[?length(@ .a .b) == 3]",
        "[{\"a\":{\"b\":\"foo\"}},{}]",
        ["[{\"a\":{\"b\":\"foo\"}}]"],
        ["\$[0]"]))
    test.case("whitespace, functions, newlines in a relative singular selector")
    test.assert(selects("\$[?length(@\n.a\n.b) == 3]",
        "[{\"a\":{\"b\":\"foo\"}},{}]",
        ["[{\"a\":{\"b\":\"foo\"}}]"],
        ["\$[0]"]))
    test.case("whitespace, functions, tabs in a relative singular selector")
    test.assert(selects("\$[?length(@\t.a\t.b) == 3]",
        "[{\"a\":{\"b\":\"foo\"}},{}]",
        ["[{\"a\":{\"b\":\"foo\"}}]"],
        ["\$[0]"]))
    test.case("whitespace, functions, returns in a relative singular selector")
    test.assert(selects("\$[?length(@\r.a\r.b) == 3]",
        "[{\"a\":{\"b\":\"foo\"}},{}]",
        ["[{\"a\":{\"b\":\"foo\"}}]"],
        ["\$[0]"]))
    test.case("whitespace, functions, spaces in an absolute singular selector")
    test.assert(selects("\$..[?length(@)==length(\$ [0] .a)]", "[{\"a\":\"foo\"},{}]", ["[\"foo\"]"], ["\$[0]['a']"]))
    test.case("whitespace, functions, newlines in an absolute singular selector")
    test.assert(selects("\$..[?length(@)==length(\$\n[0]\n.a)]", "[{\"a\":\"foo\"},{}]", ["[\"foo\"]"], ["\$[0]['a']"]))
    test.case("whitespace, functions, tabs in an absolute singular selector")
    test.assert(selects("\$..[?length(@)==length(\$\t[0]\t.a)]", "[{\"a\":\"foo\"},{}]", ["[\"foo\"]"], ["\$[0]['a']"]))
    test.case("whitespace, functions, returns in an absolute singular selector")
    test.assert(selects("\$..[?length(@)==length(\$\r[0]\r.a)]", "[{\"a\":\"foo\"},{}]", ["[\"foo\"]"], ["\$[0]['a']"]))
    test.case("whitespace, operators, space before ||")
