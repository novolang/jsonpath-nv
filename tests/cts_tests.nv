@test
fn test_cts_016() [io]
    test.case("whitespace, operators, tab after >=")
    test.assert(selects("\$[?@.b>=\t@.a]",
        "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]",
        ["[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}]"],
        ["\$[0]\n\$[1]"]))
    test.case("whitespace, operators, return after >=")
    test.assert(selects("\$[?@.b>=\r@.a]",
        "[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]",
        ["[{\"a\":1,\"b\":1},{\"a\":1,\"b\":2}]"],
        ["\$[0]\n\$[1]"]))
    test.case("whitespace, operators, space between logical not and test expression")
    test.assert(selects("\$[?! @.a]",
        "[{\"a\":\"a\",\"d\":\"e\"},{\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]",
        ["[{\"d\":\"f\"}]"],
        ["\$[1]"]))
    test.case("whitespace, operators, newline between logical not and test expression")
    test.assert(selects("\$[?!\n@.a]",
        "[{\"a\":\"a\",\"d\":\"e\"},{\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]",
        ["[{\"d\":\"f\"}]"],
        ["\$[1]"]))
    test.case("whitespace, operators, tab between logical not and test expression")
    test.assert(selects("\$[?!\t@.a]",
        "[{\"a\":\"a\",\"d\":\"e\"},{\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]",
        ["[{\"d\":\"f\"}]"],
        ["\$[1]"]))
    test.case("whitespace, operators, return between logical not and test expression")
    test.assert(selects("\$[?!\r@.a]",
        "[{\"a\":\"a\",\"d\":\"e\"},{\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]",
        ["[{\"d\":\"f\"}]"],
        ["\$[1]"]))
    test.case("whitespace, operators, space between logical not and parenthesized expression")
    test.assert(selects("\$[?! (@.a=='b')]",
        "[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"b\",\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]",
        ["[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"d\",\"d\":\"f\"}]"],
        ["\$[0]\n\$[2]"]))
    test.case("whitespace, operators, newline between logical not and parenthesized expression")
    test.assert(selects("\$[?!\n(@.a=='b')]",
        "[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"b\",\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]",
        ["[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"d\",\"d\":\"f\"}]"],
        ["\$[0]\n\$[2]"]))
    test.case("whitespace, operators, tab between logical not and parenthesized expression")
    test.assert(selects("\$[?!\t(@.a=='b')]",
        "[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"b\",\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]",
        ["[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"d\",\"d\":\"f\"}]"],
        ["\$[0]\n\$[2]"]))
    test.case("whitespace, operators, return between logical not and parenthesized expression")
    test.assert(selects("\$[?!\r(@.a=='b')]",
        "[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"b\",\"d\":\"f\"},{\"a\":\"d\",\"d\":\"f\"}]",
        ["[{\"a\":\"a\",\"d\":\"e\"},{\"a\":\"d\",\"d\":\"f\"}]"],
        ["\$[0]\n\$[2]"]))
    test.case("whitespace, selectors, space between root and bracket")
    test.assert(selects("\$ ['a']", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, newline between root and bracket")
    test.assert(selects("\$\n['a']", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, tab between root and bracket")
    test.assert(selects("\$\t['a']", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, return between root and bracket")
    test.assert(selects("\$\r['a']", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, space between bracket and bracket")
    test.assert(selects("\$['a'] ['b']", "{\"a\":{\"b\":\"ab\"}}", ["[\"ab\"]"], ["\$['a']['b']"]))
    test.case("whitespace, selectors, newline between bracket and bracket")
    test.assert(selects("\$['a'] \n['b']", "{\"a\":{\"b\":\"ab\"}}", ["[\"ab\"]"], ["\$['a']['b']"]))
    test.case("whitespace, selectors, tab between bracket and bracket")
    test.assert(selects("\$['a'] \t['b']", "{\"a\":{\"b\":\"ab\"}}", ["[\"ab\"]"], ["\$['a']['b']"]))
    test.case("whitespace, selectors, return between bracket and bracket")
    test.assert(selects("\$['a'] \r['b']", "{\"a\":{\"b\":\"ab\"}}", ["[\"ab\"]"], ["\$['a']['b']"]))
    test.case("whitespace, selectors, space between root and dot")
    test.assert(selects("\$ .a", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, newline between root and dot")
    test.assert(selects("\$\n.a", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, tab between root and dot")
    test.assert(selects("\$\t.a", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, return between root and dot")
    test.assert(selects("\$\r.a", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, space between dot and name")
    test.assert(refused("\$. a"))
    test.case("whitespace, selectors, newline between dot and name")
    test.assert(refused("\$.\na"))
    test.case("whitespace, selectors, tab between dot and name")
    test.assert(refused("\$.\ta"))
    test.case("whitespace, selectors, return between dot and name")
    test.assert(refused("\$.\ra"))
    test.case("whitespace, selectors, space between recursive descent and name")
    test.assert(refused("\$.. a"))
    test.case("whitespace, selectors, newline between recursive descent and name")
    test.assert(refused("\$..\na"))
    test.case("whitespace, selectors, tab between recursive descent and name")
    test.assert(refused("\$..\ta"))
    test.case("whitespace, selectors, return between recursive descent and name")
    test.assert(refused("\$..\ra"))
    test.case("whitespace, selectors, space between bracket and selector")
    test.assert(selects("\$[ 'a']", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, newline between bracket and selector")
    test.assert(selects("\$[\n'a']", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, tab between bracket and selector")
    test.assert(selects("\$[\t'a']", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, return between bracket and selector")
    test.assert(selects("\$[\r'a']", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, space between selector and bracket")
    test.assert(selects("\$['a' ]", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, newline between selector and bracket")
    test.assert(selects("\$['a'\n]", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, tab between selector and bracket")
    test.assert(selects("\$['a'\t]", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, return between selector and bracket")
    test.assert(selects("\$['a'\r]", "{\"a\":\"ab\"}", ["[\"ab\"]"], ["\$['a']"]))
    test.case("whitespace, selectors, space between selector and comma")
    test.assert(selects("\$['a' ,'b']", "{\"a\":\"ab\",\"b\":\"bc\"}", ["[\"ab\",\"bc\"]"], ["\$['a']\n\$['b']"]))
    test.case("whitespace, selectors, newline between selector and comma")
    test.assert(selects("\$['a'\n,'b']", "{\"a\":\"ab\",\"b\":\"bc\"}", ["[\"ab\",\"bc\"]"], ["\$['a']\n\$['b']"]))

@test
fn test_cts_017() [io]
    test.case("whitespace, selectors, tab between selector and comma")
    test.assert(selects("\$['a'\t,'b']", "{\"a\":\"ab\",\"b\":\"bc\"}", ["[\"ab\",\"bc\"]"], ["\$['a']\n\$['b']"]))
    test.case("whitespace, selectors, return between selector and comma")
    test.assert(selects("\$['a'\r,'b']", "{\"a\":\"ab\",\"b\":\"bc\"}", ["[\"ab\",\"bc\"]"], ["\$['a']\n\$['b']"]))
    test.case("whitespace, selectors, space between comma and selector")
    test.assert(selects("\$['a', 'b']", "{\"a\":\"ab\",\"b\":\"bc\"}", ["[\"ab\",\"bc\"]"], ["\$['a']\n\$['b']"]))
    test.case("whitespace, selectors, newline between comma and selector")
    test.assert(selects("\$['a',\n'b']", "{\"a\":\"ab\",\"b\":\"bc\"}", ["[\"ab\",\"bc\"]"], ["\$['a']\n\$['b']"]))
    test.case("whitespace, selectors, tab between comma and selector")
    test.assert(selects("\$['a',\t'b']", "{\"a\":\"ab\",\"b\":\"bc\"}", ["[\"ab\",\"bc\"]"], ["\$['a']\n\$['b']"]))
    test.case("whitespace, selectors, return between comma and selector")
    test.assert(selects("\$['a',\r'b']", "{\"a\":\"ab\",\"b\":\"bc\"}", ["[\"ab\",\"bc\"]"], ["\$['a']\n\$['b']"]))
    test.case("whitespace, slice, space between start and colon")
    test.assert(selects("\$[1 :5:2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, newline between start and colon")
    test.assert(selects("\$[1\n:5:2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, tab between start and colon")
    test.assert(selects("\$[1\t:5:2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, return between start and colon")
    test.assert(selects("\$[1\r:5:2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, space between colon and end")
    test.assert(selects("\$[1: 5:2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, newline between colon and end")
    test.assert(selects("\$[1:\n5:2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, tab between colon and end")
    test.assert(selects("\$[1:\t5:2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, return between colon and end")
    test.assert(selects("\$[1:\r5:2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, space between end and colon")
    test.assert(selects("\$[1:5 :2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, newline between end and colon")
    test.assert(selects("\$[1:5\n:2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, tab between end and colon")
    test.assert(selects("\$[1:5\t:2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, return between end and colon")
    test.assert(selects("\$[1:5\r:2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, space between colon and step")
    test.assert(selects("\$[1:5: 2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, newline between colon and step")
    test.assert(selects("\$[1:5:\n2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, tab between colon and step")
    test.assert(selects("\$[1:5:\t2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
    test.case("whitespace, slice, return between colon and step")
    test.assert(selects("\$[1:5:\r2]", "[1,2,3,4,5,6]", ["[2,4]"], ["\$[1]\n\$[3]"]))
