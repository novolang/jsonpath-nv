// jpeval_tests.nv — the evaluator, normalized paths and I-Regexp.
//
// The document and the expected nodelists are RFC 9535 section 1.5's
// bookstore and its table of queries.  The order cases follow section
// 2.5.1.2: a segment's result is its selectors' results in selector
// order, so `$[2,0]` answers the third element before the first.

use std.test
use std.list
use std.json
use jpquery
use jpeval
use jpregex
use std.str

// RFC 9535 § 1.5's bookstore, reduced to the members the assertions
// name.
fn store() -> Str
    let one = "{\"category\":\"reference\",\"author\":\"Nigel Rees\",\"title\":\"Sayings\",\"price\":8.95}"
    let two = "{\"category\":\"fiction\",\"author\":\"Waugh\",\"title\":\"Sword\",\"price\":12.99}"
    let bike = "{\"color\":\"red\",\"price\":399}"
    "{\"store\":{\"book\":[${one},${two}],\"bicycle\":${bike}}}"

fn doc(text: Str) -> JsonValueH [io]
    match json.parse(text)
        Some(v) => v
        None    =>
            test.assert(false)
            json.null()

fn nodes(text: Str, source: Str) -> [jpeval.JpNode] [io]
    match jpquery.parse(text)
        Err(_) =>
            test.assert(false)
            []
        Ok(q)  =>
            jpeval.select(q, doc(source))

@test
fn test_the_queries_rfc_9535_section_1_5_tabulates() [io]
    let src = store()

    test.case("every author — the table's first row")
    test.assert(list.len(nodes("$.store.book[*].author", src)) == 2)

    test.case("every author anywhere")
    test.assert(list.len(nodes("$..author", src)) == 2)

    test.case("everything in the store")
    test.assert(list.len(nodes("$.store.*", src)) == 2)

    test.case("every price in the store, the bicycle's included")
    test.assert(list.len(nodes("$.store..price", src)) == 3)

    test.case("the second book")
    test.assert(list.len(nodes("$..book[1]", src)) == 1)

    test.case("the last book, by a negative index and by a slice")
    test.assert(list.len(nodes("$..book[-1]", src)) == 1)
    test.assert(list.len(nodes("$..book[0:2]", src)) == 2)

    test.case("the books with a price below ten")
    test.assert(list.len(nodes("$..book[?@.price < 10]", src)) == 1)

    test.case("the books that have a category at all")
    test.assert(list.len(nodes("$..book[?@.category]", src)) == 2)

@test
fn test_the_order_is_the_specification_s_and_not_document_order() [io]
    let src = "{\"a\":[10,20,30]}"

    test.case("a segment's selectors answer in selector order")
    let picked = nodes("$.a[2,0]", src)
    test.assert(list.len(picked) == 2)
    test.assert(list.get(picked, 0).path == "$['a'][2]")
    test.assert(list.get(picked, 1).path == "$['a'][0]")

    test.case("a wildcard answers in document order")
    let all = nodes("$.a[*]", src)
    test.assert(list.get(all, 0).path == "$['a'][0]")

    test.case("a negative step reverses")
    let back = nodes("$.a[::-1]", src)
    test.assert(list.get(back, 0).path == "$['a'][2]")

@test
fn test_every_node_knows_where_it_was() [io]
    let src = store()

    test.case("the path is normalized: quoted throughout, no shorthand")
    let first = nodes("$.store.book[0].title", src)
    test.assert(list.get(first, 0).path == "$['store']['book'][0]['title']")

    test.case("paths alone, for a tool that already holds the document")
    match jpquery.parse("$..price")
        Err(_) => test.assert(false)
        Ok(q)  => test.assert(list.len(jpeval.select_paths(q, doc(src))) == 3)

    test.case("values alone, for a caller that will not use the locations")
    match jpquery.parse("$..price")
        Err(_) => test.assert(false)
        Ok(q)  => test.assert(list.len(jpeval.select_values(q, doc(src))) == 3)

    test.case("a path can be built without spelling the quoting rules")
    let steps = [jpeval.name_step("a"), jpeval.index_step(0)]
    test.assert(jpeval.normalized_path(steps) == "$['a'][0]")

    test.case("and read back, so a stored path is a walk rather than a query")
    match jpeval.path_steps("$['a'][0]")
        None    =>
            test.assert(false)
        Some(s) =>
            test.assert(list.len(s) == 2)
            test.assert(list.get(s, 1).is_index)

    test.case("and followed")
    match jpeval.at_path(doc("{\"a\":[7]}"), "$['a'][0]")
        None    => test.assert(false)
        Some(v) => test.assert(json.to_int(v) == Some(7))
    test.assert(jpeval.at_path(doc("{\"a\":[7]}"), "$['b']") == None)

@test
fn test_evaluation_cannot_fail() [io]
    test.case("a member nothing has selects nothing, rather than raising")
    test.assert(list.len(nodes("$.nope.deeper", "{\"a\":1}")) == 0)

    test.case("an index past the end selects nothing")
    test.assert(list.len(nodes("$.a[9]", "{\"a\":[1]}")) == 0)

    test.case("a comparison of two different types is false, not an error")
    test.assert(list.len(nodes("$[?@.a < 'x']", "[{\"a\":1}]")) == 0)

    test.case("a filter over a value that is not an object is false")
    test.assert(list.len(nodes("$[?@.a]", "[1,2,3]")) == 0)

    test.case("the one call that can fail is the one that parses")
    match jpeval.query(doc("{\"a\":1}"), "not a query")
        Ok(_)  => test.assert(false)
        Err(f) => test.assert(f.at >= 0)
    match jpeval.query(doc("{\"a\":1}"), "$.a")
        Err(_)    => test.assert(false)
        Ok(found) => test.assert(list.len(found) == 1)

@test
fn test_a_walk_can_be_bounded_without_being_made_to_fail() [io]
    test.case("the defaults are bounds no ordinary document reaches")
    let limits = jpeval.default_limits()
    test.assert(limits.max_depth > 0)
    test.assert(limits.max_nodes > 0)
    test.assert(limits.max_visits >= limits.max_nodes)

    test.case("an unbounded walk over a small document finishes")
    match jpquery.parse("$..*")
        Err(_) =>
            test.assert(false)
        Ok(q)  =>
            let sel = jpeval.select_with(q, doc("{\"a\":{\"b\":1}}"), limits)
            test.assert(sel.truncated == false)
            test.assert(sel.visited > 0)

    test.case("a bound that is reached truncates and keeps what it found")
    var tiny = jpeval.default_limits()
    tiny.max_nodes = 1
    match jpquery.parse("$..*")
        Err(_) =>
            test.assert(false)
        Ok(q)  =>
            let sel = jpeval.select_with(q, doc("{\"a\":{\"b\":1}}"), tiny)
            test.assert(sel.truncated)
            test.assert(list.len(sel.nodes) == 1)

    test.case("a singular query answers one value or none, never a list")
    match jpquery.parse_singular("$.a.b")
        Err(_) =>
            test.assert(false)
        Ok(q)  =>
            test.assert(jpeval.select_one(q, doc("{\"a\":{\"b\":7}}")) != None)
            test.assert(jpeval.select_one(q, doc("{\"a\":1}")) == None)

@test
fn test_comparison_is_structural_and_numbers_are_not_spellings() [io]
    test.case("one and one point zero are the same JSON number")
    test.assert(jpeval.value_equals(doc("1"), doc("1.0")))

    test.case("arrays and objects compare by contents, not by rendering")
    test.assert(jpeval.value_equals(doc("[1,2]"), doc("[1,2]")))
    test.assert(jpeval.value_equals(doc("[1,2]"), doc("[2,1]")) == false)
    test.assert(jpeval.value_equals(doc("{\"a\":1,\"b\":2}"), doc("{\"b\":2,\"a\":1}")))

    test.case("an empty object is not null — which std.json alone cannot say")
    test.assert(jpeval.value_equals(doc("{}"), doc("null")) == false)

    test.case("different types are never equal")
    test.assert(jpeval.value_equals(doc("1"), doc("\"1\"")) == false)

    test.case("ordering is defined for two numbers and two strings, nothing else")
    test.assert(jpeval.value_comparable(doc("1"), doc("2")))
    test.assert(jpeval.value_comparable(doc("\"a\""), doc("\"b\"")))
    test.assert(jpeval.value_comparable(doc("1"), doc("\"a\"")) == false)
    test.assert(jpeval.value_comparable(doc("[1]"), doc("[2]")) == false)
    test.assert(jpeval.value_order(doc("1"), doc("2")) == 0 - 1)
    test.assert(jpeval.value_order(doc("\"b\""), doc("\"a\"")) == 1)
    test.assert(jpeval.value_order(doc("1"), doc("\"a\"")) == 0)

@test
fn test_the_pattern_language_is_i_regexp_and_says_what_it_is_not() [io]
    test.case("what RFC 9485 has")
    test.assert(jpregex.is_iregexp("[0-9]{4}"))
    test.assert(jpregex.is_iregexp("a|b"))
    test.assert(jpregex.is_iregexp("a.*b"))

    test.case("and what it does not, each named so a person can act on it")
    test.assert(jpregex.unsupported_construct("(?i)abc") == Some("inline flag"))
    test.assert(jpregex.unsupported_construct("(a)\\1") == Some("backreference"))
    test.assert(jpregex.unsupported_construct("a(?=b)") == Some("lookahead"))
    test.assert(jpregex.unsupported_construct("a+?") == Some("lazy quantifier"))
    test.assert(jpregex.unsupported_construct("[0-9]+") == None)

    test.case("a caret is an ordinary character here, not an anchor")
    test.assert(jpregex.is_iregexp("^a"))

    test.case("match is anchored and search is not")
    match jpregex.compile("[0-9]+")
        Err(_) =>
            test.assert(false)
        Ok(re) =>
            test.assert(jpregex.is_match(re, "2026"))
            test.assert(jpregex.is_match(re, "in 2026") == false)
            test.assert(jpregex.search(re, "in 2026"))
            test.assert(re.uses_categories == false)
            test.assert(re.states > 0)

    test.case("a category escape needs the lookup, and says so when it has none")
    test.assert(jpregex.needs_categories("\\p{Lu}"))
    test.assert(jpregex.needs_categories("[a-z]") == false)
    match jpregex.compile("\\p{L}+")
        Ok(_)  => test.assert(false)
        Err(f) => test.assert(f.kind == JpNoCategoryLookup)

    test.case("and compiles when the caller supplies one")
    match jpregex.compile_with("\\p{L}+", lowercase_category)
        Err(_) =>
            test.assert(false)
        Ok(re) =>
            test.assert(re.uses_categories)
            test.assert(jpregex.is_match(re, "ada"))

    test.case("a pattern that is not I-Regexp is refused by name")
    match jpregex.compile("(?i)a")
        Ok(_)  => test.assert(false)
        Err(f) => test.assert(f.kind == JpBadRegex)

// A category lookup small enough to read: the ASCII lowercase letters
// and nothing else.  A caller with unicode-nv passes the real one.
fn lowercase_category(ch: Int) -> Str
    if ch >= 97 and ch <= 122
        "Ll"
    else
        "Cn"

@test
fn test_a_filter_can_be_given_the_category_lookup_it_needs() [io]
    test.case("the plumbing reaches match() and search() from the evaluator")
    match jpquery.parse("$[?match(@.n, '\\\\p{L}+')]")
        Err(_) =>
            test.assert(false)
        Ok(q)  =>
            let limits = jpeval.default_limits()
            let src = doc("[{\"n\":\"ada\"},{\"n\":\"7\"}]")
            let sel = jpeval.select_categorised(q, src, limits, lowercase_category)
            test.assert(list.len(sel.nodes) == 1)

    test.case("and without it that filter is false, which is section 2.4.6")
    match jpquery.parse("$[?match(@.n, '\\\\p{L}+')]")
        Err(_) =>
            test.assert(false)
        Ok(q)  =>
            test.assert(list.len(jpeval.select(q, doc("[{\"n\":\"ada\"}]"))) == 0)

// The paths a query selects, joined with a space.
fn paths_of(text: Str, source: Str) -> Str [io]
    var out: [Str] = []
    for n in nodes(text, source)
        list.push(out, n.path)
    str.join(out, " ")

@test
fn test_normalized_paths_are_read_strictly() [io]
    test.case("an escaped name reads back")
    match jpeval.path_steps("$['a\\'b\\\\c\\b\\f\\n\\r\\t\\u001f\\u00e9']")
        Some(steps) => test.assert(steps[0].name == "a'b\\c\u{8}\u{c}\n\r\t\u{1f}é")
        None        => test.assert(false)

    test.case("the root alone has no steps")
    match jpeval.path_steps("$")
        Some(steps) => test.assert(list.len(steps) == 0)
        None        => test.assert(false)
    match jpeval.at_path(doc("[1]"), "$")
        Some(v) => test.assert(json.len(v) == Some(1))
        None    => test.assert(false)

    test.case("what is not a normalized path is refused")
    for bad in ["a", "$.a", "$['a'", "$['a]", "$['a'x", "$['\\q']", "$['\\u12']", "$['\\uzzzz']",
                "$[01]", "$[-1]", "$[1", "$[]", "$['a\\"]
        test.assert(jpeval.path_steps(bad) == None)
    test.assert(jpeval.at_path(doc("{\"a\":1}"), "$.a") == None)

    test.case("a path through the wrong kind of value leads nowhere")
    test.assert(jpeval.at_path(doc("[1]"), "$['a']") == None)
    test.assert(jpeval.at_path(doc("{\"a\":1}"), "$[0]") == None)

    test.case("a name with control characters is written with section 2.7's escapes")
    test.assert(jpeval.normalized_path([jpeval.name_step("a\u{1}\tb")]) == "$['a\\u0001\\tb']")

@test
fn test_the_bounds_stop_a_walk() [io]
    let src = "{\"a\":{\"b\":{\"c\":{\"d\":1}}},\"e\":[1,2,3]}"
    let q = jpquery.parse("$..*")!

    test.case("a depth bound stops a descendant segment and says so")
    var shallow = jpeval.default_limits()
    shallow.max_depth = 1
    let d = jpeval.select_with(q, doc(src), shallow)
    test.assert(d.truncated)
    test.assert(list.len(d.nodes) == 6)

    test.case("a visit bound stops the walk")
    var few = jpeval.default_limits()
    few.max_visits = 3
    let v = jpeval.select_with(q, doc(src), few)
    test.assert(v.truncated)
    test.assert(v.visited == 3)

    test.case("a wildcard and a filter count their visits too")
    let w = jpeval.select_with(jpquery.parse("$.e[*]")!, doc(src), few)
    test.assert(list.len(w.nodes) == 3)
    var two = jpeval.default_limits()
    two.max_visits = 2
    let f = jpeval.select_with(jpquery.parse("$.e[?@ > 1]")!, doc(src), two)
    test.assert(f.truncated)
    test.assert(list.len(f.nodes) == 1)

    test.case("a node bound truncates a nodelist")
    var one = jpeval.default_limits()
    one.max_nodes = 1
    let n = jpeval.select_with(jpquery.parse("$.e[0,1]")!, doc(src), one)
    test.assert(n.truncated)
    test.assert(list.len(n.nodes) == 1)

@test
fn test_filters_compare_by_rfc_9535() [io]
    let src = "[{\"a\":{\"x\":1}},{\"a\":[1]},{\"a\":\"b\"},{\"a\":true},{\"a\":false},{\"a\":null},{\"a\":2.5},{\"a\":3},{}]"

    test.case("an object or array compares equal only to an equal object or array")
    test.assert(paths_of("$[?@.a == $[0].a]", src) == "$[0]")
    test.assert(paths_of("$[?@.a == 1]", src) == "")
    test.assert(paths_of("$[?@.a == $[1].a]", src) == "$[1]")

    test.case("the three literal words, and a missing member compared with one")
    test.assert(paths_of("$[?@.a == true]", src) == "$[3]")
    test.assert(paths_of("$[?@.a == false]", src) == "$[4]")
    test.assert(paths_of("$[?@.a == null]", src) == "$[5]")
    test.assert(paths_of("$[?@.a != null]", src) == "$[0] $[1] $[2] $[3] $[4] $[6] $[7] $[8]")
    test.assert(paths_of("$[?@.b == @.c]", src) == "$[0] $[1] $[2] $[3] $[4] $[5] $[6] $[7] $[8]")

    test.case("numbers compare across spellings, and strings by code point")
    test.assert(paths_of("$[?@.a >= 2.5]", src) == "$[6] $[7]")
    test.assert(paths_of("$[?@.a < 3.0]", src) == "$[6]")
    test.assert(paths_of("$[?@.a == 3.0]", src) == "$[7]")
    test.assert(paths_of("$[?@.a > 'a']", src) == "$[2]")
    test.assert(paths_of("$[?@.a <= 99999999999999999999]", src) == "$[6] $[7]")
    test.assert(paths_of("$[?@.a == true && @.a < 1]", src) == "")

    test.case("an object's members are filtered in document order")
    test.assert(paths_of("$[0][?@ == 1]", src) == "")
    test.assert(paths_of("$[0].a[?@ == 1]", src) == "$[0]['a']['x']")

@test
fn test_the_functions_answer_nothing_where_the_rfc_says() [io]
    let src = "[{\"s\":\"héllo\",\"o\":{\"k\":1,\"l\":2},\"n\":5}]"

    test.case("length counts characters, members and elements, and is Nothing for a number")
    test.assert(paths_of("$[?length(@.s) == 5]", src) == "$[0]")
    test.assert(paths_of("$[?length(@.o) == 2]", src) == "$[0]")
    test.assert(paths_of("$[?length(@.n) == 1]", src) == "")
    test.assert(paths_of("$[?length('ab') == 2]", src) == "$[0]")

    test.case("value is Nothing unless exactly one node")
    test.assert(paths_of("$[?value(@.o.*) == 1]", src) == "")
    test.assert(paths_of("$[?value(@.o.k) == 1]", src) == "$[0]")

    test.case("match and search are false for anything but two strings")
    test.assert(paths_of("$[?match(@.n, '5')]", src) == "")
    test.assert(paths_of("$[?search(@.s, 'll')]", src) == "$[0]")
    test.assert(paths_of("$[?match(@.s, '(')]", src) == "")

    test.case("a query built in code that is not well typed evaluates to Nothing")
    let s = JpQuery { absolute: false, segments: [JpChildSeg([JpNameSel("s")])] }
    let odd = JpCall { function: JpFnLength, arguments: [JpArgLogical(JpExprTest(s))] }
    let odd_count = JpCall { function: JpFnCount, arguments: [JpArgLiteral(JpLitInt(1))] }
    let q = JpQuery { absolute: true, segments: [JpChildSeg([JpFilterSel(
        JpExprOr(JpExprCompare(JpOperandCall(odd), JpOpEq, JpOperandLiteral(JpLitInt(1))),
                 JpExprCompare(JpOperandCall(odd_count), JpOpEq, JpOperandLiteral(JpLitInt(1)))))])] }
    test.assert(list.len(jpeval.select(q, doc(src))) == 0)

    test.case("the empty lookup knows no category")
    test.assert(jpregex.no_categories('A') == "Cn")
